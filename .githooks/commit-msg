#!/usr/bin/env sh
set -eu

commit_msg_file=$1
first_line=$(sed -n '1p' "$commit_msg_file")

pattern='^(feat|fix|docs|test|refactor|chore)\(eris-[0-9]{4}\): .+'

if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid commit message format.

Expected:
  <type>(<ticket-id>): <message>

Example:
  feat(eris-0001): add config loader

Allowed types:
  feat, fix, docs, test, refactor, chore

Ticket ID is mandatory and must start with eris- followed by exactly 4 numbers:
  eris-0001
EOF

exit 1
